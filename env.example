# 開發環境配置
NODE_ENV=development

# CDN 配置
VITE_CDN_DOMAIN=https://cdn.hyjdevelop.com
VITE_IMAGE_CDN_DOMAIN=https://images.hyjdevelop.com

# API 配置
VITE_API_URL=https://api.hyjdevelop.com

# 分析工具配置
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here
VITE_FACEBOOK_PIXEL_ID=your_fb_pixel_id_here

# 功能開關
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 注意：Sentry DSN 已直接配置在 src/utils/errorTracking.ts 中 